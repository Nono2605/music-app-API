# Copier en .env et remplir avec les vraies valeurs (jamais commité)

NODE_ENV=development
PORT=4000

# Dashboard Supabase > Project Settings > API
SUPABASE_URL=
# Nouveau système de clés Supabase (recommandé) :
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
# Ancien système (repli si le projet n'a pas encore migré) :
# SUPABASE_SERVICE_ROLE_KEY=

# Origines autorisées, séparées par des virgules (webapp + site marketing)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8110

# Droit d'écoute des lectures : "beta" (par défaut) = tout est enregistré sans revenu ;
# "live" = déduit de l'abonnement. Ne passer à "live" qu'à la fin de la bêta.
ENTITLEMENT_MODE=beta

# Sel de l'empreinte d'IP des lectures (une longue chaîne aléatoire, ex. `openssl rand -hex 32`).
# Facultatif : sans lui, plays.ip_hash reste vide. L'IP elle-même n'est jamais stockée.
IP_HASH_SECRET=

# Secret partagé avec l'app auditeur (une longue chaîne aléatoire, 32 caractères ou plus). Facultatif.
# Défini, l'API ne croit le pays, l'appareil et l'IP d'une écoute que si la requête présente ce secret
# (en-tête x-vynl-webapp-secret, envoyé par le serveur de l'app auditeur) : sans lui, n'importe quel compte
# pourrait inventer ces valeurs. À mettre D'ABORD sur Vercel (app auditeur), PUIS ici, même nom, même valeur.
WEBAPP_SHARED_SECRET=

# Vie privée (consentements). Facultatifs.
# Âge minimum pour utiliser Vynl, entre 13 et 18 (16 par défaut, la valeur sûre dans l'UE).
# PRIVACY_MIN_AGE=16
# Finalités FACULTATIVES à demander dans « Privacy & data », séparées par des virgules :
# ads_personalization, analytics. Vide (défaut) : on ne demande rien. À activer seulement
# quand la finalité existe vraiment (ex. publicité sur les comptes gratuits).
# PRIVACY_OPTIONAL_PURPOSES=

# Stripe. La clé SECRÈTE de TEST (sk_test_…) : Stripe > mode Test > Developers > API keys.
# À saisir UNIQUEMENT dans les variables de Render, jamais dans un fichier du dépôt ni dans un
# message. Une clé live (sk_live_…) est refusée tant que STRIPE_ALLOW_LIVE n'est pas « yes »
# (à ne faire qu'au lancement).
# STRIPE_SECRET_KEY=
# STRIPE_ALLOW_LIVE=
# Secret du webhook (whsec_…) : Stripe > Developers > Webhooks > votre endpoint > Signing secret.
# STRIPE_WEBHOOK_SECRET=
# Adresse de l'app auditeur (retour du paiement et du portail), sans « / » final.
# CHECKOUT_RETURN_BASE_URL=https://…
# « on » pour que Stripe calcule la TVA (Stripe Tax doit être réglé dans le tableau de bord).
# STRIPE_AUTOMATIC_TAX=
