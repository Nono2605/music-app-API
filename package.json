{
  "name": "musicapi",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "backfill:audio": "tsx src/scripts/backfillAudio.ts",
    "pilot:acrcloud": "tsx src/scripts/acrcloudPilot.ts",
    "loadtest": "tsx src/scripts/loadTest.ts",
    "test:worker": "node --test cdn-worker/test/*.test.js",
    "purge:anonymized": "tsx src/scripts/purgeAnonymized.ts",
    "worker:transcode": "node dist/worker/main.js",
    "dev:worker": "tsx src/worker/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "5.2.0",
    "helmet": "^7.1.0",
    "music-metadata": "^12.1.0",
    "stripe": "23.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
